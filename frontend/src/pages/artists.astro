---
import { getCollection } from "astro:content";
import CreatorGrid from "../components/CreatorGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import CreatorGridHeader from "../components/CreatorGridHeader.astro";

const creators = await getCollection("creators");
const creatorsTotal = creators.length;
const title = "Surviving the Present Tense - Artists";
---

<BaseLayout title={title}>
  <div class="side-padding">
    <CreatorGridHeader creatorsTotal={creatorsTotal} />
    <CreatorGrid creators={creators} />
  </div>
</BaseLayout>
