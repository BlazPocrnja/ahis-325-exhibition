---
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntry } from "astro:content";
import RichText from "../../../components/RichText.astro";
import SanityImage from "../../../components/SanityImage.astro";
import Separator from "../../../components/Separator.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";

export const getStaticPaths = async () => {
  const allProducts = await getCollection("products");

  // 1. Sort by your new 'order' field (matching your Sanity logic)
  const sortedProducts = allProducts.sort((a, b) => {
    const orderA = a.data.order ?? 999;
    const orderB = b.data.order ?? 999;
    return orderA - orderB;
  });

  const paths = await Promise.all(
    sortedProducts.map(async (product, index) => {
      const creator = await getEntry("creators", product.data.creator.id);

      // 2. Calculate the next product index (wraps to 0 if at the end)
      const nextIndex = (index + 1) % sortedProducts.length;
      const nextProduct = sortedProducts[nextIndex];

      return {
        params: {
          creator_id: product.data.creator.id,
          product_id: product.id,
        },
        props: {
          creator,
          product,
          // 3. Pass the next product's details as props
          nextProductSlug: nextProduct.id,
          nextProductCreatorId: nextProduct.data.creator.id,
        },
      };
    })
  );

  return paths;
};

type Props = {
  creator: CollectionEntry<"creators">;
  product: CollectionEntry<"products">;
  nextProductSlug: string;
  nextProductCreatorId: string;
};

const { creator, product, nextProductSlug, nextProductCreatorId } = Astro.props;
---

<BaseLayout title={product.data.name}>
  <section class="side-padding">
    <header class="title-header">
      <h2>
        {product.data.name}
        <span class="faded">by {creator.data.name}</span>
      </h2>
      <div class="nav-links">
        <a class="back" href={`/${creator.id}`}>Artist Bio</a>
		<span class="faded">/</span>
        <a class="next" href={`/${nextProductCreatorId}/catalogue/${nextProductSlug}`}>
          Next Artwork
        </a>
      </div>
    </header>
    
    <Separator />
    
    <div class="content-wrap">
      {product.data.videoLink ? (
        <iframe 
        class="product-video"
        title="vimeo-player" 
        src={product.data.videoLink} 
        referrerpolicy="strict-origin-when-cross-origin" 
        allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share" 
        allowfullscreen
      ></iframe>
      ) : product.data.gallery && product.data.gallery.length > 0 ? (
        /* CAROUSEL MODE */
        <div class="carousel-viewport" data-carousel>
          <div class="carousel-track">
            {product.data.gallery.map((img) => (
              <div class="carousel-slide">
                <SanityImage node={img} fit="contain" />
              </div>
            ))}
          </div>
          <button class="nav-btn prev" aria-label="Previous">←</button>
          <button class="nav-btn next" aria-label="Next">→</button>
        </div>
      ) : (
        <SanityImage node={product.data.imageWithAlt} width={1000} fit="contain"/>
      )}
      <div class="content">
        <RichText content={product.data.content}  />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.product-video {
    width: 100%; 
    max-width: 100%;
    aspect-ratio: 16 / 9; 
    height: auto;         
    border: none;
    display: block;
  }

  .carousel-viewport {
    width: 100%;
    height: 100%;
    overflow: hidden; 
    position: relative;
  }

  .carousel-track {
    display: flex;
    height: 100%;
    width: 100%;
  }

  .carousel-track img {
    -webkit-user-drag: none;
    -khtml-user-drag: none;
    -moz-user-drag: none;
    -o-user-drag: none;
    user-drag: none;
    pointer-events: none; /* This ensures the click/drag hits the track, not the <img> */
  }

  .carousel-track {
    cursor: grab;
    user-select: none;
  }

  .carousel-track:active {
    cursor: grabbing;
  }

  .carousel-slide {
    flex: 0 0 100%; /* Each slide is exactly the width of the viewport */
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(0, 0, 0, 0.3);
    color: white;
    border: none;
    padding: 1rem;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 10;

    /* The "Fix" - When the container is hovered, show the buttons */
    .carousel-viewport:hover & {
      opacity: 1;
      background: rgba(0, 0, 0, 0.3);
    }

    /* Interaction - When the mouse is specifically OVER the button */
    &:hover {
      background: rgba(0, 0, 0, 0.4) !important;
    }
  }

  .prev { 
    left: 20px; 
    transform: translateY(-50%) translateX(-10px); 
    transition: all 0.4s ease;
  }

  .next { 
    right: 20px; 
    transform: translateY(-50%) translateX(10px); 
    transition: all 0.4s ease;
  }

   @media screen and (max-width: 50em) {
  /* Hide nav buttons on mobile/touch devices since they can swipe */
    .nav-btn {
      display: none !important;
    }
    
    .carousel-viewport {
      /* Prevents the whole page from bouncing while swiping the gallery */
      touch-action: pan-y; 
    }
  }
</style>

<script src="../../../scripts/gallery.js"></script>