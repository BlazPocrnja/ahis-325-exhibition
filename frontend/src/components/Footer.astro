---
import Separator from "../components/Separator.astro";
---

<Separator />
<footer>
  <div class="footer__main">
    <p>
      <strong>Surviving the Present Tense</strong> — 2026
    </p>
    <p>
      Created by the <strong>Humus Collective</strong>
    </p>
    <p>
      Blaz Pocrnja • Jade Fair • Kobe Ko • Belin Canbulat
    </p>
  </div>

  <div class="footer__ecuad">
    <p>
      AHIS 325 • Art and the Social Imaginary
    </p>
    <p>
      Emily Carr University of Art + Design
    </p>
  </div>
</footer>

<style>
  footer {
    padding: 1rem 3rem;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  }
  p {
    margin: 0;
    line-height: 1.6;
    text-align: left;
    color: var(--color-text-alt);
    font-size: 0.9rem;
  }
  .footer__main p:first-child {
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text); /* Highlight the title/date */
  }
  .footer__ecuad {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    opacity: 0.6;
  }
  a {
    color: inherit;
    text-decoration: underline;
  }
</style>