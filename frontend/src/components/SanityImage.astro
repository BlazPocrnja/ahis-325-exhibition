---
import { getSanityImage } from "../utils/getSanityImage";

interface SanityImageNode {
  ref: string;
  alt?: string | null;
  caption?: string | null; // Optional, since gallery items have this
}

interface Props {
	node: SanityImageNode;
	width?: number;
	fit?: "cover" | "contain";
	aspectRatio?: "1-1" | "4-3" | "16-9" | "9-16";
}

const { node, width = 3000, fit = "cover", aspectRatio = "1-1" } = Astro.props;

const displayWidth = Math.round(width);

const image = node?.ref ? getSanityImage({ node, width: displayWidth }) : null;

---

<style>
    img {
      display: block;
      width: 100%;
      height: auto;
      image-rendering: auto; 
    }

.cover {
  object-fit: cover;
  width: 100%;
}

.contain {
  object-fit: contain;
  object-position: center;
  width: 100%;
}

.ar-1-1 {
 aspect-ratio: 1/1;
}

.ar-4-3 {
 aspect-ratio: 4/3;
}

.ar-16-9 {
 aspect-ratio: 16/9;
}

.ar-9-16 {
 aspect-ratio: 9/16;
}

</style>

{image && <img  class={`fade-in ${fit} ar-${aspectRatio}`} loading="lazy" src={image.auto('format').quality(90).sharpen(10).url()} alt={node.alt || ''} />}
