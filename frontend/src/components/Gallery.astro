---
import type { CollectionEntry } from "astro:content";
import SanityImage from "./SanityImage.astro";
import { getEntry } from "astro:content";

type Props = {
	items: CollectionEntry<"products">[];
};

const { items } = Astro.props;

const galleryItems = await Promise.all(
  items.map(async (item) => {
    const creator = await getEntry('creators', item.data.creator.id);
    return {
      ...item,
      creator: creator?.data
    };
  })
);
---

<section class="gallery">
  {galleryItems.map((item) => (
    <div class="art-frame-container">
      <div class="sticky-wrapper">
        <div class="info-layer">
            <h3>{item?.creator?.name || ""}</h3>
        </div>
        <div class="image-container">
          <SanityImage 
            node={item.data.imageWithAlt} 
            fit="contain" 
          />
        </div>
        <div class="info-layer">
            {item.data.name}
            <p>{new Date(`${item.data.publishedAt}`).getFullYear()}</p>
        </div>
        <div class="shadow-person"></div>
      </div>
    </div>
  ))}
</section>

<style>
  .art-frame-container {
    height: 300dvh;
  }

  .sticky-wrapper {
    position: sticky;
    top: 0;
    height: 100dvh;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .image-container {
    height: 80dvh;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    will-change: transform; /* Performance optimization */
    transform: scale(1.5);
  }

  /* Target the img tag inside SanityImage component */
  .image-container :global(img) {
    width: 100%;
    height: 100%;
    transition: border-radius 0.3s ease;
  }

  .info-layer {
    flex: 1;
    z-index: 1;
    text-align: center;
    opacity: 0; /* Hidden initially */
    transform: translateY(20px);
    transition: all 0.5s ease;
    will-change: opacity, transform;
  }

  .shadow-person {
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%; 
      height: 100%;
      
      background: linear-gradient(
          to right,
          transparent 0%,
          rgba(0, 0, 0, 0.8) 50%,
          transparent 100%
      );

      /* REFINED SHIMMER MASK
        We use a very wide spread (0% to 50% to 100%) to ensure 
        there are no hard "edges" to the light bar.
      */
      -webkit-mask-image: 
          linear-gradient(
              to right, 
              black 0%,
              rgba(0,0,0,0.75) 25%,
              rgba(0,0,0,0.5) 30%,
              rgba(0,0,0,0.25) 45%,
              rgba(0,0,0,0.1) 50%,
              rgba(0,0,0,0.25) 55%,
              rgba(0,0,0,0.5) 60%,
              rgba(0,0,0,0.75) 75%,
              black 100%
          ),
          radial-gradient(black 1px, transparent 1px);
      
      /* Make the shimmer mask much wider than the container 
        to give the "fade" room to breathe */
      -webkit-mask-size: 400% 100%, 4px 4px;
      -webkit-mask-repeat: repeat, repeat;
      
      -webkit-mask-composite: source-in;
      mask-composite: intersect;

      /* A slower, more "organic" duration */
      animation: skeleton-shimmer 10s infinite ease-in-out;

      /* Increase blur slightly to 80px to meld the pixels into a 'haze' */
      filter: blur(80px); 
      z-index: 2;
      pointer-events: none;
      will-change: left, -webkit-mask-position;
  }

  @keyframes skeleton-shimmer {
      0% {
          -webkit-mask-position: 0% 0, 0 0;
      }
      100% {
          /* Move it far enough that it fully clears the 80% width */
          -webkit-mask-position: 400% 0, 0 0;
      }
      
  }

  @media screen and (max-width: 50em) {
.sticky-wrapper {
    flex-direction: column; /* Stack elements vertically */
    justify-content: center;
    gap: 1.5rem; /* Space between text and image */
  }

  .image-container {
    height: auto; /* Let height be defined by width/aspect ratio */
    width: 90%;   /* Use more horizontal space */
    max-height: 50dvh; /* Don't let it take over the whole screen */
    transform: scale(1); /* Reduce scale; 1.5 is usually too big for mobile */
    order: 1; /* Keep image in the middle */
  }

  .info-layer {
    flex: 0 1 auto; /* Don't force equal height boxes */
    width: 100%;
    transform: translateY(10px); /* Smaller movement for mobile */
  }

  /* Order the elements: Creator -> Image -> Name/Year */
  .info-layer:first-of-type {
    order: 0;
  }
  
  .info-layer:last-of-type {
    order: 2;
    margin-top: -0.5rem; /* Pull caption closer to image */
  }

  .info-layer h3 {
    font-size: 1.25rem;
    margin-bottom: 0.25rem;
  }
  }
</style>

<script src="../scripts/gallery.js"></script>